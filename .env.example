# Copy this file to .env on the server. Never commit the real .env file.
MYSQL_DATABASE=LLM
MYSQL_USER=examinsight
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# ExamInsight V2 uses an independent schema. Keep migration disabled until the
# empty schema exists and a migration-capable account has been configured.
V2_FLYWAY_ENABLED=false
V2_DB_URL=jdbc:mysql://localhost:3306/examinsight_v2?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
V2_DB_USERNAME=root
V2_DB_PASSWORD=replace-with-the-v2-database-password

# V2 file payloads never live in MySQL. "local" is for local development and a
# single-node preview deployment. Public Beta will switch this gateway to OSS.
V2_STORAGE_MODE=local
V2_STORAGE_BUCKET=local-private
V2_STORAGE_KEY_SECRET=replace-with-a-separate-random-64-character-hex-secret
V2_LOCAL_STORAGE_ROOT=/app/data/v2-storage

# V2 processing fails closed: files remain quarantined when ClamAV is offline.
# The Compose backend reaches the scanner by its service name. When the backend
# runs directly in IDEA, override CLAMAV_HOST=localhost in application-local.yml.
# Public deployment must include the profile: docker compose --profile security-scan up -d
V2_ASSET_PROCESSING_ENABLED=true
V2_FILE_SCANNER_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# V2 semantic index. To rebuild safely after changing the model or losing an
# index, bump both the embedding version and index name; old records remain
# readable until the new version is complete.
V2_VECTOR_INDEXING_ENABLED=true
V2_EMBEDDING_PROVIDER=dashscope
V2_EMBEDDING_PROVIDER_MODEL=qwen3.7-text-embedding
V2_EMBEDDING_MODEL_KEY=dashscope-qwen3.7-text-embedding-1024
V2_EMBEDDING_VERSION=dashscope-qwen3.7-text-embedding-1024-v1
V2_VECTOR_INDEX_NAME=examinsight-v2-chunks-qwen3.7-embedding-1024-v1
V2_EMBEDDING_DIMENSIONS=1024

# Retrieval reads authoritative chunk text from MySQL. Elasticsearch only
# returns permission-filtered chunk identifiers and similarity scores.
V2_RETRIEVAL_ENABLED=true
V2_RETRIEVAL_TOP_K=6
V2_RETRIEVAL_MIN_SCORE=0.55
V2_RETRIEVAL_CONTEXT_TOKENS=3200

# Use http://PUBLIC_IP for the first deployment. Replace it with the HTTPS
# domain later. Multiple origins can be separated with commas.
PUBLIC_ORIGIN=http://YOUR_SERVER_PUBLIC_IP

# Authentication secrets and cookie policy. Generate AUTH_HASH_SECRET with:
# openssl rand -hex 32
AUTH_HASH_SECRET=replace-with-a-random-64-character-hex-secret
AUTH_COOKIE_SECURE=true

# Redis is required for public registration/login rate limits. Authentication
# fails closed when the shared limiter is unavailable.
REDIS_HOST=localhost
REDIS_PORT=6379

# Alibaba Cloud Captcha 2.0. Create a Web/H5 scene and use a least-privilege RAM
# identity. The backend reads credentials from Alibaba Cloud's default chain.
# "disabled" and incomplete configuration always fail closed.
HUMAN_VERIFICATION_MODE=aliyun
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Optional provider-neutral fallback for a reCAPTCHA-compatible endpoint.
HUMAN_VERIFICATION_VERIFY_URL=
HUMAN_VERIFICATION_SECRET=

# SMTP email verification. Never log or persist the plaintext verification code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
AUTH_MAIL_FROM=

# Alibaba Cloud Model Studio. A workspace API key may share these endpoints
# across chat, vision, OCR, ASR, image generation and text embeddings. Keep the
# key server-side and use the endpoints shown when the key belongs to that
# Beijing workspace; never expose it through a VITE_ variable.
DASHSCOPE_API_KEY=
DASHSCOPE_OPENAI_BASE_URL=https://YOUR_WORKSPACE_HOST.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://YOUR_WORKSPACE_HOST.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_VISION_MODEL=qwen3.7-plus
DASHSCOPE_OCR_MODEL=qwen3.5-ocr
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# iFlytek Open Platform fallback (Spark chat, PPT, image, OCR, and speech).
# Embeddings are deliberately not mixed: one vector index must use one model
# and dimension. If DashScope embedding is unavailable, retrieval uses keywords.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_SPARK_API_PASSWORD=
LEGACY_XFYUN_EMBEDDING_DIMENSIONS=2560

# Set to true for one deployment only when changing the embedding provider.
EMBEDDING_REINDEX_ON_STARTUP=false
