# Copy this file to .env on the server. Never commit the real .env file.
MYSQL_DATABASE=LLM
MYSQL_USER=examinsight
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Use http://PUBLIC_IP for the first deployment. Replace it with the HTTPS
# domain later. Multiple origins can be separated with commas.
PUBLIC_ORIGIN=http://YOUR_SERVER_PUBLIC_IP

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-jwt-secret

# Alibaba Cloud DashScope (required for chat and embedding features)
DASHSCOPE_API_KEY=

# iFlytek Open Platform (only required for the corresponding media features)
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_SPARK_API_PASSWORD=
