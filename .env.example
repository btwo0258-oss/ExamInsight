# Copy this file to .env on the server. Never commit the real .env file.
MYSQL_DATABASE=LLM
MYSQL_USER=examinsight
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# ExamInsight V2 uses an independent schema. Keep migration disabled until the
# empty schema exists and a migration-capable account has been configured.
V2_FLYWAY_ENABLED=false
V2_DB_URL=jdbc:mysql://localhost:3306/examinsight_v2?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
V2_DB_USERNAME=root
V2_DB_PASSWORD=replace-with-the-v2-database-password

# Use http://PUBLIC_IP for the first deployment. Replace it with the HTTPS
# domain later. Multiple origins can be separated with commas.
PUBLIC_ORIGIN=http://YOUR_SERVER_PUBLIC_IP

# Authentication secrets and cookie policy. Generate AUTH_HASH_SECRET with:
# openssl rand -hex 32
AUTH_HASH_SECRET=replace-with-a-random-64-character-hex-secret
AUTH_COOKIE_SECURE=true

# Redis is required for public registration/login rate limits. Authentication
# fails closed when the shared limiter is unavailable.
REDIS_HOST=localhost
REDIS_PORT=6379

# Alibaba Cloud Captcha 2.0. Create a Web/H5 scene and use a least-privilege RAM
# identity. The backend reads credentials from Alibaba Cloud's default chain.
# "disabled" and incomplete configuration always fail closed.
HUMAN_VERIFICATION_MODE=aliyun
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Optional provider-neutral fallback for a reCAPTCHA-compatible endpoint.
HUMAN_VERIFICATION_VERIFY_URL=
HUMAN_VERIFICATION_SECRET=

# SMTP email verification. Never log or persist the plaintext verification code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
AUTH_MAIL_FROM=

# Alibaba Cloud DashScope (required for Qwen chat, mind map, and exam analysis)
DASHSCOPE_API_KEY=

# iFlytek Open Platform (Spark chat, embedding, PPT, image, OCR, and speech)
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_SPARK_API_PASSWORD=

# Set to true for one deployment only when changing the embedding provider.
EMBEDDING_REINDEX_ON_STARTUP=false
